# wgflow client aliases — group WireGuard peers into people.
#
# Optional. Without it, wgflow groups by the name prefix before the first "-"
# (so "diana-iphone" and "diana-macbook" still land under "diana"), and guesses
# device kind from the name suffix. This file lets you set real display names,
# fix grouping for odd/hyphenless names, list devices so silent ones still show
# on the board, and override the device-kind guess.
#
# Point the web server at it:  wgflow web --clients-config /etc/wgflow/clients.yaml

people:
  - display: Diana
    devices:
      - diana-iphone
      - diana-macbook
  - display: Mom            # display names may be Cyrillic, spaces, anything
    devices:
      - mom-macbook

# Override the phone/laptop guess for peers the name suffix gets wrong.
device_kind:
  mom-macbook: laptop

# Optional: name bare IP targets in top/report and the web UI. Entries are
# merged on top of the builtin table (CloudFront edges etc.). A key is either
# an exact IP or a prefix ending with "." (longest prefix wins); an empty
# value removes a builtin entry.
target_names:
  "18.244.100.10": server-18-244-100-10.fra60.r.cloudfront.net
  "203.0.113.": my-own-edge.example.net

# Optional: override the read-time service/role table (see the "Service, role
# and direction" section of the README). Keys are hostname suffixes — a key
# matches the apex and every label beneath it, and the longest suffix wins.
# Each entry may set:
#   service:  the human label shown instead of the registrable domain
#   role:     ads | telemetry | push | cdn | media | sync | proxy | dns
#   category: the coarse category categorize() should pin for these hosts
# An empty mapping ({}) removes a builtin entry. These labels are applied when
# a page is rendered, so a change here re-labels retained history too.
services:
  "picsart.com":
    service: Picsart
  "ads.example.net":
    role: ads
    category: ads
  "applovin.com": {}        # drop a builtin rule
